# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.

# Email tujuan pengaduan (sementara; ganti ke email resmi Victoria saat tersedia)
COMPLAINT_TO_EMAIL=alamfahmi76@gmail.com

# Akun SMTP pengirim. Contoh Gmail: host smtp.gmail.com, port 465, password = App Password Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Opsional: alamat "From" (default = SMTP_USER)
SMTP_FROM=

# Opsional: URL kanonik situs
NEXT_PUBLIC_SITE_URL=https://victoriainsurance.co.id
